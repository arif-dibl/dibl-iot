# Coolify Environment Variables Template
# Copy these values to Coolify environment settings

# REQUIRED: Domain for OpenRemote services (e.g. fh.dripirrigation.com.bd)
OR_HOSTNAME=

# REQUIRED: Domain for Custom UI (e.g. app.dripirrigation.com.bd)
OR_CUSTOMUI_HOSTNAME=

# REQUIRED: Admin password
OR_ADMIN_PASSWORD=

# OPTIONAL
OR_EMAIL_ADMIN=
OR_SSL_PORT=-1
OR_DEV_MODE=false
OR_METRICS_ENABLED=true

# Docker images
PROXY_VERSION=latest
POSTGRESQL_VERSION=latest
KEYCLOAK_VERSION=latest
MANAGER_VERSION=latest

# -------------------------
# HAWKBIT OTA UPDATE SERVER
# -------------------------

# HawkBit Docker image version
HAWKBIT_VERSION=latest

# HawkBit Database credentials
HAWKBIT_DB_USER=postgres
HAWKBIT_DB_PASSWORD=postgres

# Keycloak OIDC credentials (create a client in Keycloak named "hawkbit")
HAWKBIT_OIDC_CLIENT_ID=hawkbit
HAWKBIT_OIDC_CLIENT_SECRET=
